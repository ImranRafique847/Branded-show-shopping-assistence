# ─────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── AWS credentials (Bedrock + DynamoDB) ─────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# ── Bedrock model IDs ────────────────────────────────────────────
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
IMAGE_EMBEDDING_MODEL_ID=amazon.titan-embed-image-v1
CHAT_MODEL_ID=amazon.nova-pro-v1:0

# ── DynamoDB table names (create these — see README) ────────────
DYNAMODB_TABLE=tretter-chat-history
LEADS_TABLE=tretter-leads

# ── Local index file paths (produced by the build scripts) ──────
TEXT_INDEX=text_index.faiss
TEXT_META=text_metadata.json
IMAGE_INDEX=image_index.faiss
IMAGE_META=image_metadata.json

# ── GitHub (optional — only needed if pushing updates via script) ─
# Your GitHub personal access token (PAT).
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (full control of private/public repositories)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=ImranRafique847/Branded-show-shopping-assistence
